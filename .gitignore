*.pt
*.pkl
*.tsv
*.tsv.gz
gene_selected.txt

# --- Python / tooling ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.claude/
.DS_Store
*.log
train_log.txt

# --- Keep the committed pre-trained bundles (negations last) ---
!pretrained_models/
!pretrained_models/**
